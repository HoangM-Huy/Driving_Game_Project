[sub_resource type="GDScript" id="GDScript_nkmm1"]
script/source = "extends Camera3D

func _ready() -> void:
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED

func _process(delta: float) -> void:
	rotation.x = clamp(rotation.x, -1, 1)
	#Input.mouse_mode = Input.MOUSE_MODE_CAPTURED

func _input(event):
	if event is InputEventMouseMotion:
		#rotate(Vector3.UP, -event.relative.x * 0.001)
		
		# When mouse is unlocked, this line (line 17) causes screen to move
		# up and down, may keep as feature
		rotate_object_local(Vector3.RIGHT, -event.relative.y * 0.001)
"

